# Public Supabase (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=

# Site (production: https://your-domain.example — no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLUB_TIMEZONE=Europe/Moscow

# Email notifications for new applications (Resend) — optional
EMAIL_FROM=
EMAIL_REPLY_TO=
APPLICATION_NOTIFY_EMAIL=
# RESEND_API_KEY=

# Optional Telegram adapter for application alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# If Timeweb cannot reach api.telegram.org, set a proxy base (no trailing slash), e.g.:
# TELEGRAM_API_BASE=https://your-telegram-proxy.example.com

# Optional CAPTCHA (only if needed later)
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=
